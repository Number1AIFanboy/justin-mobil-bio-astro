---
import type { Project } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a href={project.link} class="project-card glass rounded-2xl p-6 block group">
  <div class="flex justify-between items-start mb-4">
    <div>
      <h3 class="text-xl font-semibold tracking-tight group-hover:text-white/90">{project.title}</h3>
      <p class="text-sm text-white/60 mt-1">{project.description}</p>
    </div>
    <div class="text-[10px] px-3 py-1 rounded-full border border-white/10" style={{ color: project.accent }}>
      {project.status}
    </div>
  </div>
  
  <div class="flex items-center gap-2 text-sm text-white/50 group-hover:text-white/70 transition-colors">
    Explore →
  </div>
</a>