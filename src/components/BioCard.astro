---
import { socialLinks } from '../data/site';
---

<div class="glass rounded-3xl p-8 max-w-md w-full mx-auto relative z-10 shadow-2xl">
  <div class="flex flex-col items-center text-center">
    <!-- Profile -->
    <div class="w-24 h-24 rounded-2xl bg-zinc-800 mb-6 ring-1 ring-white/10 overflow-hidden">
      <div class="w-full h-full bg-gradient-to-br from-purple-400 to-blue-400 flex items-center justify-center text-4xl font-bold text-white">
        JM
      </div>
    </div>

    <h2 class="text-2xl font-semibold tracking-tight">Justin Mobil</h2>
    <p class="text-white/60 mt-1">Founder &amp; Systems Builder</p>

    <!-- Quick links -->
    <div class="flex gap-3 mt-6">
      {socialLinks.map(link => (
        <a href={link.href} target="_blank" class="glass px-4 py-2 rounded-xl text-xs hover:bg-white/10 transition-all">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</div>