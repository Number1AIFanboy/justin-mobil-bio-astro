---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Justin Gund | Bio</title>
		<style>
			/* Background layers for smooth dissolve transition */
			#bg-container {
				position: fixed;
				inset: 0;
				z-index: -1;
				overflow: hidden;
			}
			.bg-layer {
				position: absolute;
				inset: 0;
				background-size: cover;
				background-position: center;
				background-attachment: fixed;
				transition: opacity 0.7s ease-in-out;
			}
			.bg-day {
				background-image: url('/images/day-bg.jpg');
			}
			.bg-night {
				background-image: url('/images/night-bg.jpg');
				opacity: 0;
			}
			body.night .bg-night {
				opacity: 1;
			}
			body.night .bg-day {
				opacity: 0;
			}

			.card {
				transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
							box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
				box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 
							0 4px 6px -4px rgb(0 0 0 / 0.1);
			}
			.card:hover {
				transform: translateY(-8px);
				box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.15), 
							0 8px 10px -6px rgb(0 0 0 / 0.15);
			}

			/* Mobile-first tweaks */
			@media (max-width: 640px) {
				h1 { font-size: 3.25rem !important; }
			}
		</style>
	</head>
	<body class="day font-sans">
		<!-- Background layers for dissolve transition -->
		<div id="bg-container">
			<div class="bg-layer bg-day"></div>
			<div class="bg-layer bg-night"></div>
		</div>

		<slot />

		<script>
			function initTheme() {
				const body = document.body;
				const toggle = document.getElementById('theme-toggle');
				const saved = localStorage.getItem('theme') || 'day';
				body.className = saved;

				if (toggle) {
					const label = document.getElementById('theme-label');
					const updateLabel = () => {
						if (label) label.textContent = body.classList.contains('night') ? 'Switch to Day' : 'Switch to Night';
					};
					updateLabel();

					toggle.addEventListener('click', () => {
						const newTheme = body.classList.contains('day') ? 'night' : 'day';
						body.className = newTheme;
						localStorage.setItem('theme', newTheme);
						updateLabel();
					});
				}
			}

			document.addEventListener('DOMContentLoaded', () => {
				initTheme();
			});
		</script>
	</body>
</html>
